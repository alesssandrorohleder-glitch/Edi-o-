{"falas": [{"t0": 0.35, "t1": 1.799, "txt": "Força não ganha queda de braço."}, {"t0": 2.049, "t1": 2.701, "txt": "Técnica ganha."}, {"t0": 3.251, "t1": 5.369, "txt": "Aqui estão três técnicas que os campeões usam."}, {"t0": 6.319, "t1": 7.559, "txt": "Técnica um: o Top Roll."}, {"t0": 7.909, "t1": 11.461, "txt": "Você puxa a mão do adversário pra trás e pra cima, atacando os dedos."}, {"t0": 11.811, "t1": 14.782, "txt": "Os dedos abrem, o pulso cede, e ele perde a alavanca."}, {"t0": 15.132, "t1": 17.202, "txt": "Perfeita contra quem é mais forte que você."}, {"t0": 18.202, "t1": 20.071, "txt": "Técnica dois: o rúqui (Hook), o gancho."}, {"t0": 20.421, "t1": 23.526, "txt": "Dobre o seu pulso pra dentro e puxe o braço dele pro seu peito."}, {"t0": 23.876, "t1": 25.691, "txt": "Vira uma briga de bíceps, cara a cara."}, {"t0": 26.691, "t1": 28.123, "txt": "Técnica três: o Press."}, {"t0": 28.473, "t1": 31.476, "txt": "Coloque o ombro por cima da mão e empurre com o peso do corpo."}, {"t0": 31.826, "t1": 33.557, "txt": "É o golpe final: rápido e forte."}, {"t0": 34.507, "t1": 37.714, "txt": "E sempre: ombro junto do corpo, e nunca vire o rosto do braço."}, {"t0": 38.664, "t1": 40.7, "txt": "Qual delas você usa? Comenta aqui!"}, {"t0": 41.25, "t1": 43.117, "txt": "E segue lá o perfil pra próxima técnica."}], "words": [[0.0, 0.56, "Força"], [0.56, 0.7, "não"], [0.7, 0.92, "ganha"], [0.92, 1.14, "Queda"], [1.14, 1.3, "de"], [1.3, 1.68, "braço,"], [1.92, 2.3, "Técnica"], [2.3, 2.64, "ganha."], [3.2, 3.44, "Aqui"], [3.44, 3.66, "estão"], [3.66, 3.88, "3"], [3.88, 4.3, "técnicas"], [4.3, 4.44, "que"], [4.44, 4.54, "os"], [4.54, 4.9, "campeões"], [4.9, 5.28, "usam."], [6.12, 6.6, "Técnica"], [6.6, 6.82, "1,"], [6.98, 7.18, "Top"], [7.18, 7.46, "Roll."], [7.9, 8.04, "Você"], [8.04, 8.32, "puxa"], [8.32, 8.46, "a"], [8.46, 8.48, "mão"], [8.48, 8.62, "do"], [8.62, 9.08, "adversário"], [9.08, 9.26, "para"], [9.26, 9.5, "trás"], [9.5, 9.68, "e"], [9.68, 9.8, "para"], [9.8, 10.12, 