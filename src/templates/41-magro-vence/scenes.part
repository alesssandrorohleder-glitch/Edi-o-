// marca a almofada do herói (contorno) e o espaço entre cotovelo e almofada
function padMark(g,P,col,k){if(k<=0)return;const a=P.M([230,1226]),b=P.M([430,1266]);g.save();g.globalAlpha=k;g.strokeStyle=col;g.lineWidth=7;g.shadowColor=col;g.shadowBlur=18;g.setLineDash([16,10]);rr(g,a[0]-14,a[1]-14,b[0]-a[0]+28,b[1]-a[1]+28,18);g.stroke();g.restore();}

function timerRing(g,x,y,r,k,txt){g.save();g.strokeStyle='rgba(255,255,255,.12)';g.lineWidth=18;g.beginPath();g.arc(x,y,r,0,TAU);g.stroke();g.strokeStyle=HG;g.shadowColor=HG;g.shadowBlur=16;g.beginPath();g.arc(x,y,r,-Math.PI/2,-Math.PI/2+TAU*cl(k));g.stroke();g.restore();T(g,txt,x,y+30,90,WHT);}

// cápsula (dedo/antebraço) com contorno e brilho
function cap(g,A,B,r,C){g.save();g.lineCap='round';g.strokeStyle='rgba(50,22,10,.7)';g.lineWidth=2*r+8;g.beginPath();g.moveTo(...A);g.lineTo(...B);g.stroke();
  g.strokeStyle=C[0];g.lineWidth=2*r;g.stroke();g.strokeStyle=C[2];g.globalAlpha=.55;g.lineWidth=r*.5;g.beginPath();const n=[-(B[1]-A[1]),B[0]-A[0]],L=Math.hypot(...n)||1;
  g.moveTo(A[0]+n[0]/L*r*.45,A[1]+n[1]/L*r*.45);g.lineTo(B[0]+n[0]/L*r*.45,B[1]+n[1]/L*r*.45);g.stroke();g.restore();}
// pegada vista de perto (mão do herói entra pela esquerda). th: 1 solto pra fora, 0 travado no indicador, -1 escondido. open/openF: dedos abrindo. grab: dedo dele prendendo o dedão
function grip(g,t,cx,cy,s,o={}){const{th=0,open=0,openF=null,grab=0,hot=0,knuck=0,good=0,mir=false,A=[SKIN,SKD,SKL],B=[SK2,SK2D,SK2L]}=o;g.save();g.translate(cx,cy);g.scale(mir?-s:s,s);
  cap(g,[200,60],[560,300],78,B);g.fillStyle=B[0];rr(g,-20,-140,230,280,80);g.fill();g.strokeStyle='rgba(30,14,6,.6)';g.lineWidth=6;g.stroke();
  cap(g,[-200,60],[-560,300],80,A);g.fillStyle=A[0];rr(g,-220,-140,230,280,80);g.fill();g.strokeStyle='rgba(50,22,10,.6)';g.lineWidth=6;g.stroke();
  for(let i=0;i<4;i++){const y=-96+i*64;cap(g,[-150,y],[-205,y+6],24,B);}
  const tip=th>=0?[lerp(100,-20,th),lerp(-150,-310,th)]:[lerp(100,70,-th),lerp(-150,-112,-th)],base=[-60,-118];
  // dedos do herói por cima da mão dele
  for(let i=0;i<4;i++){const y=-96+i*64,a=(openF?openF[i]:open)*(1.0+i*.12),b=[10,y],e=[b[0]+Math.cos(-a)*150,b[1]+Math.sin(-a)*150];cap(g,b,e,28,A);
    g.strokeStyle='rgba(50,22,10,.35)';g.lineWidth=3;g.beginPath();g.arc(b[0]+70*Math.cos(-a),b[1]+70*Math.sin(-a),10,0,TAU);g.stroke();
    if(good>0)glow(g,(b[0]+e[0])/2,(b[1]+e[1])/2,70,'rgba(54,242,122,A)',.5*good);if(hot>0&&(openF?openF[i]:open)>.2)glow(g,e[0],e[1],60,'rgba(255,59,59,A)',.6*hot);}
  cap(g,base,tip,30,A);g.fillStyle='rgba(255,235,220,.8)';g.save();g.translate(...tip);g.rotate(Math.atan2(tip[1]-base[1],tip[0]-base[0]));rr(g,-6,-14,22,28,10);g.fill();g.restore();
  if(th<0){cap(g,[150,-150],[60,-130],26,B);}
  if(hot>0)glow(g,tip[0],tip[1],90+10*Math.sin(t*12),'rgba(255,59,59,A)',.8*hot);
  if(knuck>0){g.save();g.strokeStyle=HY;g.lineWidth=6;g.globalAlpha=knuck;g.shadowColor=HY;g.shadowBlur=16;g.beginPath();g.arc(base[0]+10,base[1]-4,46,0,TAU);g.stroke();g.restore();}
  if(grab>0){const e=eo(grab),G0=[230,-330],G1=[tip[0]+30,tip[1]-10];cap(g,G0,[lerp(G0[0],G1[0],e),lerp(G0[1],G1[1],e)],27,B);}
  g.restore();const M=q=>[cx+(mir?-q[0]:q[0])*s,cy+q[1]*s];return{tip:M(tip),base:M(base),M};}
function lockIcon(g,x,y,k,col=HG){if(k<=0)return;g.save();g.translate(x,y);g.scale(eob(k),eob(k));g.strokeStyle=col;g.lineWidth=12;g.beginPath();g.arc(0,-30,34,Math.PI,0);g.stroke();rr(g,-50,-30,100,80,14);g.fillStyle=col;g.fill();g.restore();}
const LOSE={dc:[-250,180],sh:[-20,10],eo_:[-30,0],ct:-.75},STUCK={dc:[0,0],ct:0},HIM={dc:[110,-140],eo_:[30,0],ct:.3};
function scaleRead(g,x,y,v,lbl,col,k){if(k<=0)return;g.save();g.translate(x,y);g.scale(eob(k),eob(k));rr(g,-190,-120,380,240,40);g.fillStyle='#1A1D22';g.fill();g.strokeStyle='rgba(255,255,255,.2)';g.lineWidth=5;g.stroke();
  rr(g,-150,-80,300,120,16);g.fillStyle='#0B1410';g.fill();T(g,Math.round(v)+' KG',0,10,96,col);T(g,lbl,0,100,46,HUD,{f:'Pop'});g.restore();}
function tag(g,s,x,y,col,k){if(k<=0)return;pill(g,s,x,y,k,col,col==HG||col==HY?INK:WHT,48);}
// antebraço horizontal a partir do cotovelo, com alavanca e partículas de força
function foreLever(g,t,x,y,L,col,lbl,k,spd){if(k<=0)return;g.save();g.globalAlpha=k;limb(g,[x,y],[x+L,y],48,38,14,SKIN,SKD,SKL,1,'fo');fist(g,x+L+30,y,44,0,SKIN,SKD,SKL);
  g.beginPath();g.arc(x,y,22,0,TAU);g.fillStyle=HY;g.fill();g.strokeStyle=col;g.lineWidth=7;g.setLineDash([16,10]);g.beginPath();g.moveTo(x,y-90);g.lineTo(x+L+30,y-90);g.stroke();g.setLineDash([]);
  for(const e of[x,x+L+30]){g.beginPath();g.moveTo(e,y-110);g.lineTo(e,y-70);g.stroke();}T(g,lbl,x+(L+30)/2,y-115,54,col);
  for(let i=0;i<3;i++){const q=((t*spd/L*300+i/3)%1);glow(g,lerp(x,x+L+30,q),y,40,col==HG?'rgba(54,242,122,A)':'rgba(255,59,59,A)',.9);}g.restore();}
// gangorra: peso grande perto do apoio x peso pequeno longe
function seesaw(g,t,k,tilt){g.save();g.translate(W/2,1040);g.fillStyle='#6B7380';g.beginPath();g.moveTo(-70,140);g.lineTo(70,140);g.lineTo(0,0);g.closePath();g.fill();
  g.rotate(tilt);g.fillStyle='#8B5A3C';rr(g,-460,-24,920,30,10);g.fill();
  g.save();g.translate(-150,-24);rr(g,-110,-190,220,190,20);g.fillStyle=HR;g.fill();T(g,'95 KG',0,-80,60,WHT);g.restore();
  g.save();g.translate(400,-24);rr(g,-70,-130,140,130,16);g.fillStyle=HG;g.fill();T(g,'60',0,-52,56,INK);g.restore();
  g.strokeStyle=HY;g.lineWidth=5;g.setLineDash([12,10]);g.beginPath();g.moveTo(0,40);g.lineTo(-150,40);g.moveTo(0,70);g.lineTo(400,70);g.stroke();g.restore();}
function steelTendon(g,t,k){const A=[180,980],B=[880,980];limb(g,A,B,80,58,20,SKIN,SKD,SKL,1,'fo');
  for(let i=0;i<4;i++){const y=950+i*18;g.save();g.strokeStyle=k>0?`rgb(${lerp(255,220,k)|0},${lerp(225,230,k)|0},${lerp(200,240,k)|0})`:'#F3D9C0';g.lineWidth=7;g.shadowColor=k>.5?'#BFE9FF':'transparent';g.shadowBlur=k*20;
    g.beginPath();g.moveTo(260,y);for(let x=260;x<=860;x+=20)g.lineTo(x,y+Math.sin(x*.03+i)*4*(1-k));g.stroke();g.restore();}
  if(k>.3){const q=(t*.8)%1;g.save();g.globalCompositeOperation='lighter';g.fillStyle='rgba(255,255,255,.6)';g.fillRect(260+q*600-30,940,60,80);g.restore();}}

