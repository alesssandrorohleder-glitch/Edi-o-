<!doctype html><meta charset="utf-8"><title>Treino a 90 graus</title>
<style>@font-face{font-family:Anton;src:url(fonts/Anton-400.woff2)}@font-face{font-family:Pop;font-weight:700;src:url(fonts/Poppins-Bold.ttf)}
html,body{margin:0;background:#000}canvas{height:100vh;display:block;margin:auto}</style><canvas id="c" width="1080" height="1920"></canvas>
<script type="module">
/* 39 — Reels narrado 60s: POR QUE TREINAR A 90° (força específica do ângulo + isometria com toalha). Gancho: bíceps todo dia → perdeu em 3s. Estilo HUD do 34.
   Canvas 2D, ilustração vetorial (braços, ossos em raio-x, atleta com rig simples). Narração Piper (pt_BR faber) em audio/voz.wav,
   tempos de fala/palavras em falas.json. Cada cena = função (g,u) desenhada num canvas próprio; corte com transição rápida (0,22s). */
const W=1080,H=1920,c=document.getElementById('c'),X0=c.getContext('2d');
for(const f of['400 80px Anton','700 60px Pop'])await document.fonts.load(f);
const TAU=Math.PI*2,cl=(v,a=0,b=1)=>Math.max(a,Math.min(b,v)),p=(t,a,b)=>cl((t-a)/(b-a)),lerp=(a,b,k)=>a+(b-a)*k,fr=v=>v-Math.floor(v);
const eo=k=>1-(1-cl(k))**3,eio=k=>{k=cl(k);return k<.5?4*k*k*k:1-(-2*k+2)**3/2;},eob=k=>{k=cl(k);const s=1.9;return 1+(s+1)*(k-1)**3+s*(k-1)**2;};
const spr=k=>k<=0?0:1-Math.exp(-k*9)*Math.cos(k*15);
const rnd=(i,s=1)=>fr(Math.sin(i*127.1+s*311.7)*43758.5453);
const mk=(w=W,h=H)=>{const k=document.createElement('canvas');k.width=w;k.height=h;return[k,k.getContext('2d')];};
const RED='#FF2E3F',LIME='#C6FF2E',WHT='#FFFFFF',INK='#0B0C10',SKIN='#E6A27A',SKD='#B9714C',SKL='#F6C3A0',SK2='#8A5A3C',SK2D='#5E3B26',SK2L='#A8714E',TOP='#1B1E26',BONE='#EAF6FF',XR='#59C8FF';
const beat=t=>Math.exp(-fr(t/.5)*6);    // 120 bpm
function T(g,s,x,y,size,col,o={}){const{f='Anton',al='center',ls=0,a=1,maxw=960,stroke=null,sw=0,bl='alphabetic'}=o;if(a<=0)return;g.save();g.globalAlpha*=a;
  g.font=`${f=='Anton'?400:700} ${size}px ${f}`;g.letterSpacing=ls+'px';let w=g.measureText(s).width;if(w>maxw){size*=maxw/w;g.font=`${f=='Anton'?400:700} ${size}px ${f}`;}
  g.textAlign=al;g.textBaseline=bl;if(stroke){g.lineJoin='round';g.lineWidth=sw;g.strokeStyle=stroke;g.strokeText(s,x,y);}g.fillStyle=col;g.fillText(s,x,y);g.restore();}
function rr(g,x,y,w,h,r){g.beginPath();g.moveTo(x+r,y);g.arcTo(x+w,y,x+w,y+h,r);g.arcTo(x+w,y+h,x,y+h,r);g.arcTo(x,y+h,x,y,r);g.arcTo(x,y,x+w,y,r);g.closePath();}
// título que sobe de uma máscara
function rise(g,s,x,y,size,col,k,o={}){if(k<=0)return;g.save();g.beginPath();g.rect(0,y-size*1.05,W,size*1.3);g.clip();T(g,s,x,y+(1-eo(k))*size*1.1,size,col,o);g.restore();}
// palavra que bate (escala grande → normal)
function slam(g,s,x,y,size,col,k,o={}){if(k<=0)return;const e=k<1?lerp(2.2,1,eo(k*1.6)):1;g.save();g.translate(x,y);g.scale(e,e);T(g,s,0,0,size,col,{...o,a:(o.a??1)*cl(k*4)});g.restore();}
function pill(g,s,x,y,k,bg,fg,size=44,o={}){if(k<=0)return;g.save();g.font=`700 ${size}px Pop`;const w=g.measureText(s).width+size*1.3,h=size*1.55;g.translate(x,y);const e=eob(k);g.scale(e,e);g.globalAlpha=cl(k*3);
  rr(g,o.al=='left'?0:-w/2,-h/2,w,h,h/2);g.fillStyle=bg;g.fill();T(g,s,o.al=='left'?size*.65:0,size*.36,size,fg,{f:'Pop',al:o.al||'center'});g.restore();}
const Wd=await (await fetch('falas.json')).json();

/* ---------- desenho: membros, mãos, ossos, halteres ---------- */
const gs=(s,c,w)=>Math.exp(-(((s-c)/w)**2));
// membro com anatomia: kind 'up' (braço: bíceps na frente, tríceps atrás, deltoide no ombro) ou 'fo' (antebraço: braquiorradial perto do cotovelo, afina no punho)
// side = lado da "frente" do músculo (+1 = normal à esquerda do sentido A→B)
function limb(g,A,B,ra,rb,bul,col,dark,lite,side=1,kind=null){const dx=B[0]-A[0],dy=B[1]-A[1],L=Math.hypot(dx,dy),ux=dx/L,uy=dy/L,nx=-uy*side,ny=ux*side,N=26,P=[],Q=[];
  kind=kind||(ra>=rb*1.12?'up':'fo');
  const fr_=s=>kind=='up'?lerp(ra,rb,s)*.92+bul*gs(s,.56,.24):lerp(ra,rb,s**.8)+bul*1.25*gs(s,.2,.2);
  const bk_=s=>kind=='up'?lerp(ra,rb,s)*.92+bul*.55*gs(s,.34,.26):lerp(ra,rb,s**.8)*.96+bul*.35*gs(s,.28,.22);
  for(let i=0;i<=N;i++){const s=i/N,cx=A[0]+dx*s,cy=A[1]+dy*s;P.push([cx+nx*fr_(s),cy+ny*fr_(s)]);Q.push([cx-nx*bk_(s),cy-ny*bk_(s)]);}
  const path=()=>{g.beginPath();g.moveTo(...P[0]);for(let i=1;i<P.length;i++)g.lineTo(...P[i]);const a0=Math.atan2(ny,nx),r1=(fr_(1)+bk_(1))/2,r0=(fr_(0)+bk_(0))/2;
    g.arc(B[0]+(nx*(fr_(1)-bk_(1)))/2,B[1]+(ny*(fr_(1)-bk_(1)))/2,r1,a0,a0+Math.PI,side>0);
    for(let i=Q.length-1;i>=0;i--)g.lineTo(...Q[i]);g.arc(A[0]+(nx*(fr_(0)-bk_(0)))/2,A[1]+(ny*(fr_(0)-bk_(0)))/2,r0,a0+Math.PI,a0,side>0);g.closePath();};
  const R=ra+bul,gr=g.createLinearGradient(A[0]+nx*R,A[1]+ny*R,A[0]-nx*R,A[1]-ny*R);gr.addColorStop(0,lite);gr.addColorStop(.3,col);gr.addColorStop(.72,dark);gr.addColorStop(.86,col);gr.addColorStop(1,dark);
  path();g.fillStyle=gr;g.fill();
  g.save();path();g.clip();g.lineCap='round';
  g.strokeStyle='rgba(255,236,220,.42)';g.lineWidth=9;g.beginPath();for(let i=4;i<=N-4;i++){const s=i/N,r=fr_(s)-14;const x=A[0]+dx*s+nx*r,y=A[1]+dy*s+ny*r;i==4?g.moveTo(x,y):g.lineTo(x,y);}g.stroke();
  g.strokeStyle='rgba(255,190,150,.25)';g.lineWidth=6;g.beginPath();for(let i=3;i<=N-3;i++){const s=i/N,r=bk_(s)-6;const x=A[0]+dx*s-nx*r,y=A[1]+dy*s-ny*r;i==3?g.moveTo(x,y):g.lineTo(x,y);}g.stroke();
  g.strokeStyle='rgba(90,40,20,.32)';g.lineWidth=5;const c=(s,o)=>[A[0]+dx*s+nx*o,A[1]+dy*s+ny*o];
  if(kind=='up'){let q0=c(.2,fr_(.2)),q1=c(.34,0),q2=c(.3,-bk_(.3)*.6);g.beginPath();g.moveTo(...q0);g.quadraticCurveTo(...q1,...q2);g.stroke();
    q0=c(.42,-bk_(.42)*.2);q1=c(.62,fr_(.62)*.15);q2=c(.88,-bk_(.88)*.1);g.beginPath();g.moveTo(...q0);g.quadraticCurveTo(...q1,...q2);g.globalAlpha=.6;g.stroke();g.globalAlpha=1;}
  else{const q0=c(.1,fr_(.1)*.2),q1=c(.35,fr_(.35)*.05),q2=c(.7,-bk_(.7)*.25);g.beginPath();g.moveTo(...q0);g.quadraticCurveTo(...q1,...q2);g.stroke();}
  g.restore();path();g.lineWidth=5;g.strokeStyle='rgba(70,28,12,.6)';g.lineJoin='round';g.stroke();
  if(kind=='up'){const cx=A[0]+ux*ra*.35,cy=A[1]+uy*ra*.35,an=Math.atan2(uy,ux);g.save();g.translate(cx,cy);g.rotate(an);const dr=ra*1.1;
    const g2=g.createLinearGradient(0,side*dr,0,-side*dr);g2.addColorStop(0,lite);g2.addColorStop(.45,col);g2.addColorStop(1,dark);g.beginPath();g.ellipse(dr*.25,0,dr*1.05,dr,0,0,TAU);g.fillStyle=g2;g.fill();
    g.strokeStyle='rgba(70,28,12,.5)';g.lineWidth=5;g.beginPath();g.ellipse(dr*.25,0,dr*1.05,dr,0,side>0?-.4:Math.PI*.2,side>0?Math.PI*.8:Math.PI*1.4);g.stroke();
    g.strokeStyle='rgba(255,236,220,.38)';g.lineWidth=8;g.beginPath();g.ellipse(dr*.25,0,dr*.78,dr*.74,0,side>0?.6:-2.5,side>0?2.4:-.7);g.stroke();g.restore();}
  return{nx,ny,L};}
// punho fechado (vista lateral, dedos pro +x, punho/pulso pro −y): uma peça só, nós dos dedos em ondas, vincos, polegar com unha
function fistPath(g,r){g.beginPath();g.moveTo(-.62*r,-1.08*r);g.bezierCurveTo(-.98*r,-.7*r,-1.02*r,.2*r,-.9*r,.62*r);g.bezierCurveTo(-.8*r,.98*r,-.2*r,1.08*r,.3*r,1.0*r);
  const K=[[.62,.8],[.78,.38],[.8,-.06],[.74,-.5]];let y=1.0*r;g.quadraticCurveTo(.62*r,.98*r,.7*r,.78*r);
  K.forEach(([kx,ky],i)=>{const y1=(ky-.22)*r;g.quadraticCurveTo((kx+.24)*r,(ky+.02)*r,(kx+(i==3?.02:.06))*r,y1);});
  g.quadraticCurveTo(.62*r,-1.0*r,.18*r,-1.08*r);g.closePath();}
function fist(g,x,y,r,ang,col,dark,lite){g.save();g.translate(x,y);g.rotate(ang);
  const gr=g.createLinearGradient(-r,-r,r*.9,r*.9);gr.addColorStop(0,dark);gr.addColorStop(.35,col);gr.addColorStop(.7,lite);gr.addColorStop(1,col);
  fistPath(g,r);g.fillStyle=gr;g.fill();
  g.save();fistPath(g,r);g.clip();g.lineCap='round';
  g.fillStyle='rgba(60,25,10,.22)';g.beginPath();g.ellipse(-.75*r,.1*r,.35*r,1.1*r,0,0,TAU);g.fill();                 // sombra nas costas da mão
  g.strokeStyle='rgba(90,40,20,.45)';g.lineWidth=r*.07;for(const yy of[.58,.16,-.28]){g.beginPath();g.moveTo(.86*r,yy*r);g.quadraticCurveTo(.55*r,(yy+.04)*r,.3*r,(yy+.1)*r);g.stroke();}   // vincos dos dedos
  g.strokeStyle='rgba(255,236,220,.5)';g.lineWidth=r*.09;g.beginPath();g.moveTo(-.5*r,-.85*r);g.quadraticCurveTo(-.82*r,-.1*r,-.62*r,.6*r);g.stroke();   // brilho
  g.restore();fistPath(g,r);g.lineWidth=r*.065;g.strokeStyle='rgba(70,28,12,.65)';g.lineJoin='round';g.stroke();
  // polegar deitado sobre o indicador
  g.beginPath();g.moveTo(-.55*r,-.62*r);g.bezierCurveTo(-.2*r,-.86*r,.42*r,-.82*r,.66*r,-.6*r);g.quadraticCurveTo(.76*r,-.42*r,.58*r,-.34*r);g.bezierCurveTo(.25*r,-.36*r,-.15*r,-.3*r,-.5*r,-.22*r);g.closePath();
  const g2=g.createLinearGradient(0,-.85*r,0,-.25*r);g2.addColorStop(0,lite);g2.addColorStop(1,col);g.fillStyle=g2;g.fill();g.stroke();
  g.beginPath();g.ellipse(.5*r,-.56*r,.14*r,.1*r,-.3,0,TAU);g.fillStyle='rgba(255,226,214,.85)';g.fill();g.lineWidth=r*.035;g.stroke();
  g.restore();}
// duas mãos travadas na queda de braço (mão de trás envolvida pela da frente)
function clasp(g,C,tilt){g.save();g.translate(C[0],C[1]);g.rotate(tilt*.4);
  fist(g,26,-10,64,Math.PI+.25,SK2,SK2D,SK2L);                           // mão do adversário (fica atrás)
  // mão do herói envolvendo: palma + 4 dedos dando a volta por cima
  g.beginPath();g.moveTo(-92,70);g.bezierCurveTo(-110,10,-90,-60,-40,-78);g.bezierCurveTo(20,-98,70,-84,92,-58);g.quadraticCurveTo(108,-36,92,-14);g.bezierCurveTo(60,-4,20,0,-6,20);g.quadraticCurveTo(-30,60,-40,96);g.closePath();
  let gr=g.createLinearGradient(-100,-80,90,40);gr.addColorStop(0,SKD);gr.addColorStop(.45,SKIN);gr.addColorStop(.8,SKL);gr.addColorStop(1,SKIN);g.fillStyle=gr;g.fill();g.lineWidth=4.5;g.strokeStyle='rgba(70,28,12,.65)';g.stroke();
  g.lineCap='round';g.strokeStyle='rgba(90,40,20,.45)';g.lineWidth=4;for(let i=0;i<3;i++){const x=-30+i*34;g.beginPath();g.moveTo(x,-86+i*4);g.quadraticCurveTo(x+14,-50,x+4,-14+i*4);g.stroke();}
  for(let i=0;i<4;i++){const x=-44+i*34,y=-84+Math.abs(i-1.5)*6;g.beginPath();g.ellipse(x+14,y+10,9,6,-.2,0,TAU);g.fillStyle='rgba(255,226,214,.7)';g.fill();}   // unhas
  // polegar do herói por cima
  g.beginPath();g.moveTo(-70,40);g.bezierCurveTo(-60,0,-20,-20,24,-18);g.quadraticCurveTo(44,-14,38,4);g.bezierCurveTo(10,8,-30,30,-44,62);g.closePath();gr=g.createLinearGradient(0,-20,0,60);gr.addColorStop(0,SKL);gr.addColorStop(1,SKIN);g.fillStyle=gr;g.fill();g.stroke();
  g.beginPath();g.ellipse(26,-6,12,8,-.2,0,TAU);g.fillStyle='rgba(255,226,214,.85)';g.fill();g.lineWidth=2.5;g.stroke();g.restore();}
function bone(g,A,B,w,col=BONE,glow=XR){const dx=B[0]-A[0],dy=B[1]-A[1],L=Math.hypot(dx,dy),a=Math.atan2(dy,dx);g.save();g.translate(...A);g.rotate(a);g.shadowColor=glow;g.shadowBlur=w*1.1;g.fillStyle=col;
  g.beginPath();g.ellipse(0,0,w*.95,w*1.05,0,0,TAU);g.ellipse(L,0,w*.95,w*1.05,0,0,TAU);g.fill();g.beginPath();g.moveTo(w*.2,-w*.42);g.quadraticCurveTo(L/2,-w*.3,L-w*.2,-w*.42);g.lineTo(L-w*.2,w*.42);g.quadraticCurveTo(L/2,w*.3,w*.2,w*.42);g.fill();
  g.shadowBlur=0;g.fillStyle='rgba(120,170,210,.35)';g.fillRect(w*.6,-w*.08,L-w*1.2,w*.16);g.restore();}
function dumbbell(g,x,y,ang,len,end=false,col='#2A2E38'){g.save();g.translate(x,y);g.rotate(ang);if(end){g.fillStyle='#151820';g.beginPath();for(let i=0;i<6;i++){const a=i/6*TAU+Math.PI/6;g.lineTo(Math.cos(a)*len*.42,Math.sin(a)*len*.42);}g.fill();
    g.strokeStyle='#3B4150';g.lineWidth=6;g.stroke();g.fillStyle='#9AA3B5';g.beginPath();g.arc(0,0,len*.1,0,TAU);g.fill();g.restore();return;}
  g.fillStyle='#8C95A8';g.fillRect(-len/2,-7,len,14);for(const s of[-1,1]){rr(g,s*len/2-(s>0?26:0),-len*.32,26,len*.64,8);g.fillStyle=col;g.fill();rr(g,s*len/2-(s>0?26:0)+(s>0?-18:26),-len*.26,18,len*.52,6);g.fill();}g.restore();}
function hammer(g,x,y,ang,len){g.save();g.translate(x,y);g.rotate(ang);rr(g,-11,-len,22,len*1.18,10);const gr=g.createLinearGradient(-11,0,11,0);gr.addColorStop(0,'#7A4A22');gr.addColorStop(.5,'#B87B3E');gr.addColorStop(1,'#6A3E1A');g.fillStyle=gr;g.fill();
  rr(g,-len*.38,-len-58,len*.76,70,14);const g2=g.createLinearGradient(0,-len-58,0,-len+12);g2.addColorStop(0,'#D8DEE8');g2.addColorStop(.5,'#7E8696');g2.addColorStop(1,'#3E4452');g.fillStyle=g2;g.fill();g.restore();}
// ombro→cotovelo→mão (lado de fora), retorna pontos
function arm(g,S,a1,a2,L1,L2,o={}){const{r=[52,44,34],bul=26,col=SKIN,dk=SKD,lt=SKL,fistR=40,hand=true,hold=null,wrist=0,glow=null}=o;
  const E=[S[0]+Math.sin(a1)*L1,S[1]+Math.cos(a1)*L1],a=a1+a2,Hn=[E[0]+Math.sin(a)*L2,E[1]+Math.cos(a)*L2];
  limb(g,E,Hn,r[1]*.95,r[2],bul*.5,col,dk,lt,o.side??1,'fo');limb(g,S,E,r[0],r[1],bul,col,dk,lt,o.side??1,'up');
  const ha=-a+wrist,Hc=[Hn[0]+Math.sin(a+wrist)*fistR*.7,Hn[1]+Math.cos(a+wrist)*fistR*.7];
  if(hold)hold(Hc,a+wrist);if(hand)fist(g,Hc[0],Hc[1],fistR,ha,col,dk,lt);return{S,E,H:Hn,Hc,a};}
function glowSeg(g,A,B,w,col,k){if(k<=0)return;g.save();g.globalCompositeOperation='lighter';g.strokeStyle=col;g.lineCap='round';g.shadowColor=col;g.shadowBlur=60;
  g.globalAlpha=k*.16;g.lineWidth=w*1.5;g.beginPath();g.moveTo(...A);g.lineTo(...B);g.stroke();g.globalAlpha=k*.22;g.lineWidth=w*.55;g.stroke();g.restore();}
// atleta de perfil (busto), olhando pra direita
function athlete(g,cx,cy,s,o={}){g.save();g.translate(cx,cy);g.scale(s,s);
  g.fillStyle='rgba(0,0,0,.35)';g.beginPath();g.ellipse(10,560,300,40,0,0,TAU);g.fill();
  // braço de trás (sombra)
  if(o.back)o.back(g);
  // tronco em V (ombros largos, cintura fina) + trapézio + regata
  g.beginPath();g.moveTo(-60,-150);g.quadraticCurveTo(-120,-80,-200,-50);g.quadraticCurveTo(-230,120,-150,330);g.quadraticCurveTo(-120,460,-110,560);g.lineTo(130,560);g.quadraticCurveTo(140,460,170,330);g.quadraticCurveTo(250,120,215,-50);g.quadraticCurveTo(140,-80,80,-150);g.closePath();
  let gr=g.createLinearGradient(-210,0,220,0);gr.addColorStop(0,SKD);gr.addColorStop(.55,SKIN);gr.addColorStop(.8,SKL);gr.addColorStop(1,SKD);g.fillStyle=gr;g.fill();g.strokeStyle='rgba(70,28,12,.55)';g.lineWidth=5;g.stroke();
  g.beginPath();g.moveTo(-150,-30);g.quadraticCurveTo(-200,150,-140,330);g.quadraticCurveTo(-112,460,-104,560);g.lineTo(124,560);g.quadraticCurveTo(134,460,162,330);g.quadraticCurveTo(220,150,170,-30);g.quadraticCurveTo(140,-40,120,-40);
  g.quadraticCurveTo(110,90,20,100);g.quadraticCurveTo(-70,90,-95,-45);g.quadraticCurveTo(-125,-45,-150,-30);g.closePath();
  gr=g.createLinearGradient(-200,0,220,0);gr.addColorStop(0,'#0E1016');gr.addColorStop(.55,TOP);gr.addColorStop(.85,'#323848');gr.addColorStop(1,'#14161C');g.fillStyle=gr;g.fill();
  g.strokeStyle='rgba(255,255,255,.08)';g.lineWidth=4;g.beginPath();g.moveTo(-60,200);g.quadraticCurveTo(40,240,150,190);g.stroke();
  g.strokeStyle=LIME;g.lineWidth=8;g.beginPath();g.moveTo(-95,-45);g.quadraticCurveTo(-70,90,20,100);g.quadraticCurveTo(110,90,120,-40);g.stroke();
  // pescoço
  g.beginPath();g.moveTo(-50,-180);g.lineTo(-56,-60);g.quadraticCurveTo(10,-30,70,-60);g.lineTo(64,-190);g.closePath();gr=g.createLinearGradient(-60,0,70,0);gr.addColorStop(0,SKD);gr.addColorStop(.7,SKIN);gr.addColorStop(1,SKD);g.fillStyle=gr;g.fill();
  g.fillStyle='rgba(70,28,12,.25)';g.beginPath();g.ellipse(10,-150,60,24,0,0,TAU);g.fill();
  // cabeça de perfil: crânio + mandíbula + nariz
  g.beginPath();g.moveTo(-70,-240);g.bezierCurveTo(-80,-380,90,-400,118,-290);g.quadraticCurveTo(126,-262,140,-232);g.quadraticCurveTo(146,-220,128,-214);g.quadraticCurveTo(134,-196,124,-186);
  g.quadraticCurveTo(128,-170,112,-160);g.quadraticCurveTo(100,-130,60,-128);g.quadraticCurveTo(-10,-130,-50,-170);g.quadraticCurveTo(-75,-200,-70,-240);g.closePath();
  gr=g.createRadialGradient(60,-280,20,20,-250,170);gr.addColorStop(0,SKL);gr.addColorStop(.55,SKIN);gr.addColorStop(1,SKD);g.fillStyle=gr;g.fill();g.strokeStyle='rgba(70,28,12,.55)';g.lineWidth=5;g.stroke();
  g.fillStyle='rgba(40,25,18,.22)';g.beginPath();g.moveTo(-40,-180);g.quadraticCurveTo(20,-150,104,-170);g.quadraticCurveTo(100,-132,60,-130);g.quadraticCurveTo(-10,-132,-40,-180);g.fill();   // barba rala
  // cabelo (degradê)
  g.beginPath();g.moveTo(-74,-232);g.bezierCurveTo(-86,-390,96,-410,120,-300);g.quadraticCurveTo(60,-330,-10,-300);g.quadraticCurveTo(-40,-270,-48,-230);g.closePath();
  gr=g.createLinearGradient(0,-400,0,-230);gr.addColorStop(0,'#2A1C16');gr.addColorStop(.7,'#140D0A');gr.addColorStop(1,'rgba(20,13,10,.55)');g.fillStyle=gr;g.fill();
  // orelha, olho, sobrancelha, boca
  g.beginPath();g.ellipse(-20,-235,20,30,-.1,0,TAU);g.fillStyle=SKD;g.fill();g.strokeStyle='rgba(70,28,12,.5)';g.lineWidth=4;g.stroke();
  g.fillStyle='#FFFFFF';g.beginPath();g.ellipse(84,-262,15,10,0,0,TAU);g.fill();g.fillStyle='#1A1310';g.beginPath();g.arc(90,-262,8,0,TAU);g.fill();
  g.strokeStyle='#1A1310';g.lineWidth=9;g.lineCap='round';g.beginPath();g.moveTo(62,-290);g.quadraticCurveTo(84,-298,110,-288);g.stroke();
  g.lineWidth=6;g.beginPath();g.moveTo(96,-178);g.quadraticCurveTo(108,-174,116,-182);g.stroke();
  if(o.front)o.front(g);g.restore();}

/* ---------- fundo ---------- */
function bg(g,t,mode){const top=mode=='red'?'#1A0608':mode=='lime'?'#0C1206':'#0B0C12',bot='#050507';let gr=g.createLinearGradient(0,0,0,H);gr.addColorStop(0,top);gr.addColorStop(1,bot);g.fillStyle=gr;g.fillRect(0,0,W,H);
  const col=mode=='red'?'255,46,63':mode=='lime'?'198,255,46':'120,140,255';gr=g.createRadialGradient(W/2,H*.45,50,W/2,H*.45,W*1.05);gr.addColorStop(0,`rgba(${col},${.16+.08*beat(t)})`);gr.addColorStop(1,`rgba(${col},0)`);g.fillStyle=gr;g.fillRect(0,0,W,H);
  g.strokeStyle=`rgba(${col},.07)`;g.lineWidth=2;const o=(t*40)%90;for(let y=-90+o;y<H;y+=90){g.beginPath();g.moveTo(0,y);g.lineTo(W,y);g.stroke();}for(let x=0;x<W;x+=90){g.beginPath();g.moveTo(x,0);g.lineTo(x,H);g.stroke();}}
function streaks(g,t,col,n=14){g.save();g.globalCompositeOperation='lighter';for(let i=0;i<n;i++){const y=rnd(i,2)*H,x=fr(rnd(i,3)+t*(.6+rnd(i,4)))*W*1.6-W*.3,l=120+rnd(i,5)*280;g.globalAlpha=.10+.12*rnd(i,6);g.fillStyle=col;g.fillRect(x,y,l,3);}g.restore();}
function sparks(g,cx,cy,t0,t,col=RED,n=26){const u=t-t0;if(u<0||u>1.2)return;g.save();g.globalCompositeOperation='lighter';for(let i=0;i<n;i++){const a=rnd(i,7)*TAU,v=500+rnd(i,8)*900,d=v*u*(1-u*.35),x=cx+Math.cos(a)*d,y=cy+Math.sin(a)*d+300*u*u;
  g.globalAlpha=(1-u/1.2);g.strokeStyle=col;g.lineWidth=5;g.beginPath();g.moveTo(x,y);g.lineTo(x-Math.cos(a)*40,y-Math.sin(a)*40);g.stroke();}g.restore();}

/* ---------- queda de braço (vista lateral) ---------- */
function wrestle(g,t,o={}){const{shake=1,tilt=0,good=false,dc=[0,0],sh=[0,0],eh=[0,0],eo_=[0,0],ct=0}=o,sx=Math.sin(t*37)*9*shake+Math.sin(t*23)*6*shake,sy=Math.cos(t*31)*5*shake;
  const C=[540+sx+tilt*120+dc[0],850+sy+Math.abs(tilt)*40+dc[1]];
  // mesa
  // mesa oficial: tampo vermelho/branco, almofadas azuis, pernas vermelhas
  g.fillStyle='#120E10';rr(g,-40,1330,W+80,700,0);g.fill();for(const lx of[160,900]){const lg=g.createLinearGradient(lx,0,lx+60,0);lg.addColorStop(0,'#7E1018');lg.addColorStop(.5,'#D3222E');lg.addColorStop(1,'#7E1018');g.fillStyle=lg;g.fillRect(lx,1320,60,700);}
  let gr=g.createLinearGradient(0,1240,0,1330);gr.addColorStop(0,'#E23040');gr.addColorStop(1,'#8E1220');g.fillStyle=gr;rr(g,-40,1250,W+80,80,6);g.fill();g.fillStyle='#F2F2F2';g.fillRect(-40,1262,W+80,10);
  for(const px of[230,650]){rr(g,px,1226,200,40,10);const pg=g.createLinearGradient(0,1226,0,1266);pg.addColorStop(0,'#3F6BE0');pg.addColorStop(1,'#1D3E9E');g.fillStyle=pg;g.fill();}
  // braço do adversário (direita)
  const EO=[760+eo_[0],1215+eo_[1]],SO=[1180,1010];limb(g,EO,[C[0]+38,C[1]+40],70,50,24,SK2,SK2D,SK2L,1,'fo');limb(g,SO,EO,92,70,30,SK2,SK2D,SK2L,1,'up');
  // braço do herói (esquerda)
  const EH=[320+eh[0],1215+eh[1]],SH=good?[-40+sh[0],1080+sh[1]]:[-130+sh[0],980+sh[1]];limb(g,EH,[C[0]-38,C[1]+40],72,52,26,SKIN,SKD,SKL,-1,'fo');limb(g,SH,EH,96,72,good?44:32,SKIN,SKD,SKL,-1,'up');
  // mãos travadas
  clasp(g,C,tilt+ct);
  return{C,EH,SH,EO,SO};}

