/* ---------- estilo "laboratório de biomecânica" (ref. @theory_armwrestling) ---------- */
const HUD='#E9EEF5',HG='#36F27A',HR='#FF3B3B',HY='#FFD43B';
// ginásio escuro: parede de concreto + grama verde no chão
const[GYM,gy]=mk();{let gr=gy.createLinearGradient(0,0,0,H);gr.addColorStop(0,'#1C1E22');gr.addColorStop(.55,'#2A2D32');gr.addColorStop(.72,'#202326');gr.addColorStop(1,'#101112');gy.fillStyle=gr;gy.fillRect(0,0,W,H);
  for(let i=0;i<9000;i++){const x=Math.random()*W,y=Math.random()*H*.8,v=Math.random();gy.fillStyle=`rgba(${v>.5?255:0},${v>.5?255:0},${v>.5?255:0},${.02+Math.random()*.03})`;gy.fillRect(x,y,2+Math.random()*3,2+Math.random()*3);}
  gy.strokeStyle='rgba(0,0,0,.35)';gy.lineWidth=4;for(const y of[420,820,1220]){gy.beginPath();gy.moveTo(0,y);gy.lineTo(W,y);gy.stroke();}for(const x of[260,800]){gy.beginPath();gy.moveTo(x,0);gy.lineTo(x,1500);gy.stroke();}
  gr=gy.createLinearGradient(0,1500,0,H);gr.addColorStop(0,'#1E5A2A');gr.addColorStop(1,'#0C2612');gy.fillStyle=gr;gy.fillRect(0,1500,W,H-1500);
  gr=gy.createRadialGradient(W/2,700,100,W/2,700,900);gr.addColorStop(0,'rgba(255,255,255,.10)');gr.addColorStop(1,'rgba(0,0,0,.35)');gy.fillStyle=gr;gy.fillRect(0,0,W,H);}
function gym(g){g.drawImage(GYM,0,0);}
function title(g,a,b,k=1){if(k<=0)return;T(g,a,W/2,330,84,'rgba(233,238,245,.55)',{a:k,ls:2});if(b)T(g,b,W/2,410,60,'rgba(233,238,245,.32)',{f:'Pop',a:k,ls:6});}
// esqueleto sobre o braço (ombro–cotovelo–punho)
function skel(g,pts,col,k=1){if(k<=0)return;g.save();g.globalAlpha=k;g.strokeStyle=col;g.lineWidth=7;g.lineCap='round';g.lineJoin='round';g.shadowColor=col;g.shadowBlur=14;g.beginPath();pts.forEach((q,i)=>i?g.lineTo(...q):g.moveTo(...q));g.stroke();
  for(const q of pts){g.beginPath();g.arc(q[0],q[1],13,0,TAU);g.fillStyle=col;g.fill();}g.restore();}
function arcDeg(g,c,a0,a1,r,txt,col,k=1){if(k<=0)return;g.save();g.globalAlpha=k;g.strokeStyle=col;g.lineWidth=7;g.shadowColor=col;g.shadowBlur=14;g.beginPath();g.arc(c[0],c[1],r,a0,a0+(a1-a0)*cl(k));g.stroke();g.restore();
  const am=(a0+a1)/2;T(g,txt,c[0]+Math.cos(am)*(r+60),c[1]+Math.sin(am)*(r+60)+18,58,col,{a:k,stroke:'rgba(0,0,0,.6)',sw:8});}
// medidor de vantagem mecânica
function gauge(g,vL,vR,k=1){if(k<=0)return;g.save();g.globalAlpha=k;T(g,'VANTAGEM MECÂNICA',W/2,520,40,'rgba(233,238,245,.45)',{f:'Pop',ls:3});
  T(g,Math.round(vL)+'%',150,610,84,vL>=vR?HG:HUD,{al:'left'});T(g,Math.round(vR)+'%',W-150,610,84,vR>=vL?HG:HUD,{al:'right'});
  for(let i=0;i<=20;i++){const x=W/2-250+i*25,h=i%5?26:44;g.fillStyle='rgba(233,238,245,.35)';g.fillRect(x-2,590-h/2,4,h);}
  const m=W/2+cl((vL-vR)/40,-1,1)*-220;g.fillStyle=HG;g.shadowColor=HG;g.shadowBlur=20;rr(g,m-9,550,18,80,9);g.fill();g.restore();}
// mão em contorno com mapa de calor nos dedos (heat 0 = verde, 1 = vermelho)
function handIcon(g,x,y,s,heat,mirror=false,k=1){if(k<=0)return;g.save();g.translate(x,y);g.scale(mirror?-s:s,s);g.globalAlpha=k;
  const F=[[-.62,-1.0,.78],[-.2,-1.2,.95],[.22,-1.18,.98],[.62,-1.0,.82]],c=`rgb(${lerp(54,255,heat)|0},${lerp(242,59,heat)|0},${lerp(122,59,heat)|0})`;
  g.lineCap='round';F.forEach(([bx,by,L])=>{g.strokeStyle=c;g.lineWidth=30;g.globalAlpha=k*.75;g.beginPath();g.moveTo(bx*60,by*60*.2);g.lineTo(bx*60,by*60-L*30);g.stroke();
    g.globalAlpha=k;g.strokeStyle=HUD;g.lineWidth=5;g.beginPath();g.moveTo(bx*60-14,by*60*.2);g.lineTo(bx*60-14,by*60-L*30);g.arc(bx*60,by*60-L*30,14,Math.PI,0);g.lineTo(bx*60+14,by*60*.2);g.stroke();});
  g.strokeStyle=HUD;g.lineWidth=5;g.beginPath();g.moveTo(-52,-8);g.quadraticCurveTo(-60,70,-20,100);g.lineTo(30,100);g.quadraticCurveTo(60,60,56,-8);g.stroke();
  g.beginPath();g.moveTo(-52,30);g.quadraticCurveTo(-100,10,-96,-30);g.stroke();g.restore();}
function lever(g,A,B,col,txt,k=1){if(k<=0)return;const P=[lerp(A[0],B[0],cl(k)),lerp(A[1],B[1],cl(k))];g.save();g.strokeStyle=col;g.lineWidth=8;g.setLineDash([18,12]);g.shadowColor=col;g.shadowBlur=14;g.beginPath();g.moveTo(...A);g.lineTo(...P);g.stroke();g.setLineDash([]);
  g.fillStyle=col;g.beginPath();g.arc(A[0],A[1],14,0,TAU);g.fill();g.beginPath();g.arc(P[0],P[1],20,0,TAU);g.lineWidth=6;g.stroke();g.restore();if(txt)T(g,txt,(A[0]+P[0])/2+70,(A[1]+P[1])/2+16,52,col,{a:k,stroke:'rgba(0,0,0,.6)',sw:8});}
function chip(g,s,x,y,k,col,fg=INK){pill(g,s,x,y,k,col,fg,50);}
// cena base: disputa vista de lado + pontos-chave (mão do adversário = hook, mão do herói = top roll)
function stage(g,t,o={}){const z=o.z||1,cx=o.cx??540,cy=o.cy??1000;g.save();g.translate(W/2,H*.56);g.scale(z,z);g.translate(-cx,-cy);g.translate(0,160);
  const P=wrestle(g,t,{shake:o.shake??.25,dc:o.dc||[0,0],eh:o.eh||[0,0],sh:o.sh||[0,0],eo_:o.eo_||[0,0],ct:o.ct||0});
  const mapP=q=>{const x=(q[0])*z,y=(q[1]+160)*z;return[W/2+x-cx*z,H*.56+y-cy*z];};
  const Wo=[P.C[0]+38,P.C[1]+40],Wh=[P.C[0]-38,P.C[1]+40];g.restore();
  return{C:mapP(P.C),Wo:mapP(Wo),Wh:mapP(Wh),EO:mapP(P.EO),SO:mapP(P.SO),EH:mapP(P.EH),SH:mapP(P.SH),z};}

const AV=await new Promise(r=>{const i=new Image();i.onload=()=>r(i);i.src='avatar.png';});
/* ---------- cenas ---------- */
const S=[];const sc=(t0,mode,tr,fn)=>S.push({t0,mode,tr,fn});
const ANTI={dc:[-120,-150],eh:[-30,0],sh:[-50,-30],ct:-.35},ARM={dc:[60,40],eh:[20,0],sh:[40,20],ct:.25};
const mix=(a,b,k)=>{const o={};for(const n of['dc','eh','sh','eo_']){const A=a[n]||[0,0],B=b[n]||[0,0];o[n]=[lerp(A[0],B[0],k),lerp(A[1],B[1],k)];}o.ct=lerp(a.ct||0,b.ct||0,k);return o;};
function arw(g,A,B,col,k,w=12){if(k<=0)return;const P=[lerp(A[0],B[0],eo(k)),lerp(A[1],B[1],eo(k))],an=Math.atan2(P[1]-A[1],P[0]-A[0]);g.save();g.strokeStyle=g.fillStyle=col;g.lineWidth=w;g.lineCap='round';g.shadowColor=col;g.shadowBlur=16;
  g.beginPath();g.moveTo(...A);g.lineTo(...P);g.stroke();g.translate(...P);g.rotate(an);g.beginPath();g.moveTo(18,0);g.lineTo(-26,-26);g.lineTo(-26,26);g.closePath();g.fill();g.restore();}
function glow(g,x,y,r,col,a){if(a<=0)return;const gr=g.createRadialGradient(x,y,0,x,y,r);gr.addColorStop(0,col.replace('A',a));gr.addColorStop(1,col.replace('A',0));g.fillStyle=gr;g.fillRect(x-r,y-r,2*r,2*r);}
// ponto ao longo de uma polilinha (q de 0 a 1)
function along(P,q){const L=[];let tot=0;for(let i=1;i<P.length;i++){const d=Math.hypot(P[i][0]-P[i-1][0],P[i][1]-P[i-1][1]);L.push(d);tot+=d;}let r=q*tot;for(let i=0;i<L.length;i++){if(r<=L[i]){const k=r/L[i];return[lerp(P[i][0],P[i+1][0],k),lerp(P[i][1],P[i+1][1],k)];}r-=L[i];}return P[P.length-1];}
// atleta de COSTAS na mesa: dorsal (lat) brilha, bíceps (bic) brilha vermelho, flow = força subindo das costas até a mão
function backView(g,t,cx,cy,s,o={}){const{lat=0,bic=0,flow=0,pull=0}=o;g.save();g.translate(cx,cy);g.scale(s,s);
  // mesa vista de trás
  g.fillStyle='#B8121E';g.fillRect(-520,170,1040,40);g.fillStyle='#F2F2F2';g.fillRect(-520,150,1040,24);g.fillStyle='#2E5BD6';rr(g,280,128,150,30,8);g.fill();
  const sw=Math.sin(t*2)*4,rot=-pull*22;
  g.save();g.translate(0,sw);g.rotate(rot*Math.PI/900);
  // braço esquerdo (segura o pino)
  const L=arm(g,[-205,-170],-.45,.25,260,200,{r:[58,48,36],bul:22,fistR:42,side:-1});
  // tronco de costas
  g.beginPath();g.moveTo(-70,-260);g.quadraticCurveTo(-150,-220,-235,-200);g.quadraticCurveTo(-270,-60,-215,60);g.quadraticCurveTo(-160,200,-140,420);g.lineTo(140,420);g.quadraticCurveTo(160,200,215,60);g.quadraticCurveTo(270,-60,235,-200);g.quadraticCurveTo(150,-220,70,-260);g.closePath();
  let gr=g.createLinearGradient(-260,0,260,0);gr.addColorStop(0,SKD);gr.addColorStop(.45,SKIN);gr.addColorStop(.7,SKL);gr.addColorStop(1,SKD);g.fillStyle=gr;g.fill();g.strokeStyle='rgba(70,28,12,.55)';g.lineWidth=5;g.stroke();
  // dorsais
  for(const m of[-1,1]){g.beginPath();g.moveTo(m*40,-110);g.quadraticCurveTo(m*190,-150,m*228,-90);g.quadraticCurveTo(m*230,40,m*150,230);g.quadraticCurveTo(m*80,250,m*30,190);g.closePath();
    g.fillStyle=`rgba(70,28,12,.16)`;g.fill();g.strokeStyle='rgba(70,28,12,.4)';g.lineWidth=4;g.stroke();
    if(lat>0){g.save();g.globalAlpha=lat;g.fillStyle='rgba(54,242,122,.45)';g.shadowColor=HG;g.shadowBlur=40;g.fill();g.strokeStyle=HG;g.lineWidth=7;g.stroke();g.restore();}}
  // escápulas + coluna
  g.strokeStyle='rgba(70,28,12,.45)';g.lineWidth=5;for(const m of[-1,1]){g.beginPath();g.moveTo(m*45,-200);g.quadraticCurveTo(m*130,-190,m*150,-120);g.quadraticCurveTo(m*120,-60,m*60,-50);g.stroke();}
  g.beginPath();g.moveTo(0,-230);g.lineTo(0,400);g.stroke();
  // shorts
  g.fillStyle=TOP;g.fillRect(-150,380,300,60);
  // pescoço + cabeça de costas
  g.fillStyle=SKD;g.fillRect(-48,-320,96,90);g.beginPath();g.arc(0,-370,92,0,TAU);gr=g.createRadialGradient(-20,-400,10,0,-370,95);gr.addColorStop(0,'#3A2A20');gr.addColorStop(1,'#14100C');g.fillStyle=gr;g.fill();
  for(const m of[-1,1]){g.beginPath();g.ellipse(m*90,-360,18,30,0,0,TAU);g.fillStyle=SKD;g.fill();}
  // braço direito (luta): ombro → cotovelo na mesa → mão em cima
  const R=arm(g,[210,-170],.55-pull*.12,2.45+pull*.1,330,300,{r:[64,52,38],bul:30+bic*12,fistR:48});
  if(bic>0){const m=[lerp(R.S[0],R.E[0],.5),lerp(R.S[1],R.E[1],.5)];glow(g,m[0],m[1],120+10*Math.sin(t*14),'rgba(255,59,59,A)',.8*bic);}
  if(flow>0){const P=[[120,90],[200,-60],R.S,R.E,R.Hc],n=7;g.save();g.globalCompositeOperation='lighter';g.strokeStyle='rgba(54,242,122,.5)';g.lineWidth=16;g.lineCap='round';g.lineJoin='round';g.shadowColor=HG;g.shadowBlur=30;g.globalAlpha=flow;
    g.beginPath();P.forEach((q,i)=>i?g.lineTo(...q):g.moveTo(...q));g.setLineDash([30,24]);g.lineDashOffset=-t*220;g.stroke();g.setLineDash([]);
    for(let i=0;i<n;i++){const q=((t*.7+i/n)%1);const p_=along(P,q);g.beginPath();g.arc(p_[0],p_[1],16,0,TAU);g.fillStyle=HG;g.fill();}g.restore();}
  g.restore();g.restore();const M=q=>[cx+q[0]*s,cy+(q[1]+sw)*s];return{hand:M(R.Hc),bic:M([lerp(R.S[0],R.E[0],.5),lerp(R.S[1],R.E[1],.5)]),lat:M([140,40]),sh:M(R.S)};}
// barra de força
function fbar(g,lbl,v,y,col,k){if(k<=0)return;T(g,lbl,120,y-30,50,HUD,{al:'left',f:'Pop',a:k});rr(g,120,y,840,80,20);g.fillStyle='rgba(255,255,255,.08)';g.fill();
  const w=840*v*eo(k);if(w>2){rr(g,120,y,w,80,20);g.fillStyle=col;g.shadowColor=col;g.shadowBlur=24;g.fill();g.shadowBlur=0;}}

const step=(g,n,t,t0)=>{const k=p(t,t0,t0+.25);if(k<=0)return;g.save();g.translate(150,600);g.scale(eob(k),eob(k));g.beginPath();g.arc(0,0,82,0,TAU);g.fillStyle=HG;g.fill();T(g,''+n,0,36,110,INK);g.restore();};
const HIGH={dc:[-110,-140],eh:[-25,0],sh:[-40,-25],ct:-.3},LOW={dc:[80,90],eo_:[20,0],ct:.3},NEU={dc:[0,0],ct:0},PULL={dc:[-150,-130],eh:[-50,0],sh:[-110,-40],ct:-.4};
// régua de altura ao lado das mãos
function ruler(g,x,yA,yB,k,colA=HG,colB=HR){if(k<=0)return;g.save();g.globalAlpha=k;g.strokeStyle='rgba(233,238,245,.5)';g.lineWidth=4;g.beginPath();g.moveTo(x,yA-120);g.lineTo(x,yB+120);g.stroke();
  for(let y=yA-120;y<=yB+120;y+=24){g.beginPath();g.moveTo(x,y);g.lineTo(x+((y-yA+120)%96?16:30),y);g.stroke();}
  for(const[y,c]of[[yA,colA],[yB,colB]]){g.strokeStyle=c;g.lineWidth=6;g.shadowColor=c;g.shadowBlur=14;g.beginPath();g.moveTo(x-40,y);g.lineTo(x+60,y);g.stroke();}
  g.shadowBlur=0;arw(g,[x+90,yB],[x+90,yA+8],HY,cl(k*1.4),8);g.restore();}
function gloves(g,C,k){if(k<=0)return;g.save();g.globalAlpha=k;for(const[dx,dy]of[[-20,-150],[30,120]]){g.beginPath();g.ellipse(C[0]+dx,C[1]+dy,80,52,0,0,TAU);g.fillStyle='#F4F5F7';g.fill();g.strokeStyle='rgba(0,0,0,.4)';g.lineWidth=4;g.stroke();
  for(let i=-1;i<=1;i++){g.beginPath();g.moveTo(C[0]+dx+i*26,C[1]+dy-30);g.lineTo(C[0]+dx+i*26,C[1]+dy+20);g.stroke();}}g.restore();}
// porta vista de cima: dobradiça à esquerda, empurrão perto dela
function door(g,t,k,ang){g.save();g.translate(200,800);g.fillStyle='#3A3F48';g.fillRect(-60,-40,60,80);g.fillRect(700,-40,200,80);
  g.rotate(-ang);g.fillStyle='#8B5A3C';rr(g,0,-26,680,52,8);g.fill();g.strokeStyle='rgba(0,0,0,.5)';g.lineWidth=4;g.stroke();g.fillStyle='#D9B65A';g.beginPath();g.arc(640,0,14,0,TAU);g.fill();
  g.restore();g.save();g.translate(200,800);g.beginPath();g.arc(0,0,22,0,TAU);g.fillStyle=HY;g.fill();g.restore();T(g,'DOBRADIÇA',200,720,44,HY,{f:'Pop',a:k});}

const WIN={dc:[230,170],eo_:[70,10],ct:.75},GOOD={dc:[-110,-140],eh:[-25,0],sh:[-40,-25],ct:-.3},LUNGE={dc:[60,-20],sh:[230,-70],eh:[50,-20],ct:.1};
const rot=(p,a)=>[p[0]*Math.cos(a)-p[1]*Math.sin(a),p[0]*Math.sin(a)+p[1]*Math.cos(a)];
// stage com mapa de coordenadas (M) para marcar a almofada
function stage2(g,t,o={}){const P=stage(g,t,o),z=o.z||1,cx=o.cx??540,cy=o.cy??1000;P.M=q=>[W/2+q[0]*z-cx*z,H*.56+(q[1]+160)*z-cy*z];return P;}
function desat(g,k){if(k<=0)return;g.save();g.globalCompositeOperation='saturation';g.globalAlpha=k;g.fillStyle='#808080';g.fillRect(0,0,W,H);g.restore();g.fillStyle=`rgba(120,0,10,${.25*k})`;g.fillRect(0,0,W,H);}
function stamp(g,s,x,y,size,col,k,ang=-.12){if(k<=0)return;const e=lerp(2.6,1,eo(cl(k*1.5)));g.save();g.translate(x,y);g.rotate(ang);g.scale(e,e);g.globalAlpha=cl(k*4);g.font=`${size}px Anton`;const w=g.measureText(s).width+80;
  g.strokeStyle=col;g.lineWidth=14;rr(g,-w/2,-size*.72,w,size*1.05,18);g.stroke();T(g,s,0,size*.18,size,col,{stroke:'rgba(0,0,0,.5)',sw:8});g.restore();
  if(k<1){const r=p(k,0,.6);g.save();g.globalAlpha=(1-r)*.8;g.strokeStyle=col;g.lineWidth=10;g.beginPath();g.arc(x,y,100+r*600,0,TAU);g.stroke();g.restore();}}
function confetti(g,t0,t,n=60){const k=t-t0;if(k<0||k>2)return;for(let i=0;i<n;i++){const a=i*2.39996,v=500+(i*97%400),x=W/2+Math.cos(a)*v*k,y=800+Math.sin(a)*v*k+700*k*k;
  g.save();g.translate(x,y);g.rotate(k*8+i);g.globalAlpha=cl(1.6-k);g.fillStyle=[HG,HY,WHT][i%3];g.fillRect(-10,-5,20,10);g.restore();}}
function whistle(g,x,y,s,k){if(k<=0)return;g.save();g.translate(x,y);g.scale(s*eob(k),s*eob(k));g.fillStyle='#D9DDE3';g.beginPath();g.arc(0,0,60,0,TAU);g.fill();rr(g,0,-60,130,50,14);g.fill();
  g.fillStyle='#22262E';g.beginPath();g.arc(0,0,22,0,TAU);g.fill();g.strokeStyle='#22262E';g.lineWidth=6;g.beginPath();g.arc(0,0,60,0,TAU);g.stroke();
  for(let i=0;i<3;i++){g.strokeStyle=HY;g.lineWidth=8;g.beginPath();g.arc(150,-35,30+i*26,-.7,.7);g.stroke();}g.restore();}
function badge3(g,n,k){if(k<=0)return;g.save();g.globalAlpha=k;rr(g,W-300,470,230,90,45);g.fillStyle=HR;g.fill();T(g,`FALTA ${n}/3`,W-185,532,52,WHT);g.restore();}
// vista de cima (base no topView do 30): rel = mão livre solta o pino, lean = ombro passa do centro, line = linha do centro
function tv(g,cx,cy,s,t,o={}){const{rel=0,lean=0,line=0,pegHi=0,lineRed=0,shGlow=0}=o;g.save();g.translate(cx,cy);g.scale(s,s);
  rr(g,-320,-200,640,400,40);let gr=g.createLinearGradient(0,-200,0,200);gr.addColorStop(0,'#C7202C');gr.addColorStop(1,'#8E1220');g.fillStyle=gr;g.fill();g.strokeStyle='#5A0A12';g.lineWidth=10;g.stroke();
  for(const[xx,yy]of[[-40,-120],[40,120]]){g.fillStyle='#2E5BD6';g.beginPath();g.ellipse(xx,yy,80,34,0,0,TAU);g.fill();}
  if(line>0){g.save();g.strokeStyle=lineRed>0?`rgb(255,${lerp(255,59,lineRed)|0},${lerp(255,59,lineRed)|0})`:WHT;g.lineWidth=8;g.setLineDash([26,18]);g.shadowColor=g.strokeStyle;g.shadowBlur=18;g.beginPath();g.moveTo(-320,0);g.lineTo(-320+640*eo(line),0);g.stroke();g.restore();}
  g.fillStyle='#F4C430';rr(g,-280,-28,28,56,10);g.fill();rr(g,252,-28,28,56,10);g.fill();
  if(pegHi>0){g.save();g.strokeStyle=HY;g.lineWidth=7;g.globalAlpha=pegHi;g.shadowColor=HY;g.shadowBlur=20;g.beginPath();g.arc(-266,0,70+8*Math.sin(t*10),0,TAU);g.stroke();g.restore();}
  const torso=(c,a,col)=>{g.save();g.translate(...c);g.rotate(a);const gg=g.createLinearGradient(0,-90,0,90);gg.addColorStop(0,'#3A4150');gg.addColorStop(1,col);g.beginPath();g.ellipse(0,0,230,88,0,0,TAU);g.fillStyle=gg;g.fill();g.strokeStyle='rgba(255,255,255,.18)';g.lineWidth=6;g.stroke();
    for(const sx of[-1,1]){g.beginPath();g.arc(sx*192,0,52,0,TAU);g.fillStyle=SKD;g.fill();}g.restore();};
  const head=(c,look,hair,skin)=>{g.save();g.translate(...c);g.rotate(look);g.fillStyle=skin;g.beginPath();g.ellipse(-6,-72,14,20,0,0,TAU);g.ellipse(-6,72,14,20,0,0,TAU);g.fill();
    g.fillStyle=hair;g.beginPath();g.arc(0,0,72,0,TAU);g.fill();g.fillStyle=skin;g.beginPath();g.ellipse(44,0,28,42,0,-Math.PI/2,Math.PI/2);g.fill();g.beginPath();g.moveTo(70,-13);g.lineTo(94,0);g.lineTo(70,13);g.fill();g.restore();};
  const OT=[20,-330];limb(g,[210,OT[1]],[250,-40],46,38,8,SK2,SK2D,SK2L,-1,'fo');torso(OT,0,'#1A1D24');
  limb(g,[-170,OT[1]],[20,-120],48,40,12,SK2,SK2D,SK2L,1,'up');limb(g,[20,-120],[0,-14],40,32,10,SK2,SK2D,SK2L,1,'fo');head([OT[0],OT[1]-4],Math.PI/2,'#1A1310',SK2D);
  const Tc=[60-lean*40,300-lean*300],ra=-.3+lean*.15,Rs=v=>{const q=rot(v,ra);return[Tc[0]+q[0],Tc[1]+q[1]];};
  const SHR=Rs([192,0]),SHL=Rs([-192,0]),EL=[70,120-lean*20],HD=[0,10],FH=[lerp(-250,-330,eo(rel)),lerp(40,330,eo(rel))];
  limb(g,SHL,FH,46,38,8,SKIN,SKD,SKL,-1,'fo');if(rel>0)fist(g,FH[0],FH[1],36,Math.PI/2,SKIN,SKD,SKL);torso(Tc,ra,'#151820');
  limb(g,SHR,EL,50,42,14,SKIN,SKD,SKL,1,'up');limb(g,EL,HD,42,32,10,SKIN,SKD,SKL,1,'fo');fist(g,0,-6,44,-Math.PI/2,SKIN,SKD,SKL);
  if(shGlow>0)glow(g,SHR[0],SHR[1],120,'rgba(255,59,59,A)',shGlow);
  const Hh=Rs([0,0]);head(Hh,Math.atan2(HD[1]-Hh[1],HD[0]-Hh[0]),'#1A1310',SKD);
  g.restore();const M=q=>[cx+q[0]*s,cy+q[1]*s];return{SHR:M(SHR),FH:M(FH),peg:M([-266,0]),line:M([0,0])};}
// marca a almofada do herói (contorno) e o espaço entre cotovelo e almofada
function padMark(g,P,col,k){if(k<=0)return;const a=P.M([230,1226]),b=P.M([430,1266]);g.save();g.globalAlpha=k;g.strokeStyle=col;g.lineWidth=7;g.shadowColor=col;g.shadowBlur=18;g.setLineDash([16,10]);rr(g,a[0]-14,a[1]-14,b[0]-a[0]+28,b[1]-a[1]+28,18);g.stroke();g.restore();}

const LOSE={dc:[-250,180],sh:[-20,10],eo_:[-30,0],ct:-.75},STUCK={dc:[0,0],ct:0};
// braço grande flexionando (pose de "bíceps todo dia")
function bigArm(g,t,x,y,s,fl=1){g.save();g.translate(x,y);g.scale(s,s);const pu=.5+.5*Math.sin(t*9);g.fillStyle=TOP;rr(g,-240,-60,250,560,80);g.fill();g.beginPath();g.arc(-110,-170,100,0,TAU);g.fillStyle='#1A1310';g.fill();
  const R=arm(g,[0,0],1.55,1.45+.25*fl*pu,330,290,{r:[86,70,48],bul:58+16*fl*pu,fistR:56});
  g.strokeStyle='rgba(70,28,12,.35)';g.lineWidth=5;g.beginPath();g.moveTo(130,-40);g.quadraticCurveTo(190,-70,250,-50);g.stroke();g.restore();return R;}
// transferidor no cotovelo, ponteiro no ângulo a (graus)
function protractor(g,c,r,a,k,col=HG){if(k<=0)return;g.save();g.globalAlpha=k;g.strokeStyle='rgba(233,238,245,.5)';g.lineWidth=4;g.beginPath();g.arc(c[0],c[1],r,Math.PI,TAU);g.stroke();
  for(let d=0;d<=180;d+=10){const an=Math.PI+d/180*Math.PI,l=d%30?14:28;g.beginPath();g.moveTo(c[0]+Math.cos(an)*r,c[1]+Math.sin(an)*r);g.lineTo(c[0]+Math.cos(an)*(r-l),c[1]+Math.sin(an)*(r-l));g.stroke();}
  const an=Math.PI+a/180*Math.PI;g.strokeStyle=col;g.lineWidth=8;g.shadowColor=col;g.shadowBlur=16;g.beginPath();g.moveTo(...c);g.lineTo(c[0]+Math.cos(an)*(r+20),c[1]+Math.sin(an)*(r+20));g.stroke();g.restore();}
// gráfico força x ângulo
function chart(g,t,o={}){const{k=1,band=0,drop=0,peak=0,label='FORÇA',curve='band'}=o;if(k<=0)return;const X0=130,X1=950,Y0=1250,Y1=700,fx=d=>X0+(X1-X0)*d/180;g.save();g.globalAlpha=k;
  rr(g,80,640,920,720,30);g.fillStyle='rgba(10,12,14,.8)';g.fill();g.strokeStyle='rgba(233,238,245,.4)';g.lineWidth=4;g.beginPath();g.moveTo(X0,Y1-20);g.lineTo(X0,Y0);g.lineTo(X1,Y0);g.stroke();
  for(const d of[0,45,90,135,180])T(g,d+'°',fx(d),Y0+60,40,d==90?HY:'rgba(233,238,245,.6)',{f:'Pop'});T(g,label,X0+10,Y1-40,40,'rgba(233,238,245,.6)',{f:'Pop',al:'left'});
  if(band>0){g.fillStyle=`rgba(54,242,122,${.18*band})`;g.fillRect(fx(75),Y1,fx(105)-fx(75),Y0-Y1);T(g,'±15°',fx(90),Y1+50,48,HG,{a:band});}
  const f=d=>curve=='band'?.25+.75*Math.exp(-(((d-90)/(14+60*(1-band)))**2))*(band>0?1:.0)+(band>0?0:.45):.2+.8*Math.sin(Math.PI*d/180)**1.6;
  const n=k*180;g.lineWidth=9;g.lineCap='round';for(let d=2;d<=n;d+=2){const out=Math.abs(d-90)>15;g.strokeStyle=out&&drop>0?`rgb(${lerp(54,255,drop)|0},${lerp(242,59,drop)|0},${lerp(122,59,drop)|0})`:HG;
    g.beginPath();g.moveTo(fx(d-2),Y0-(Y0-Y1)*f(d-2));g.lineTo(fx(d),Y0-(Y0-Y1)*f(d));g.stroke();}
  if(peak>0){const x=fx(90),y=Y0-(Y0-Y1)*f(90);g.fillStyle=HY;g.shadowColor=HY;g.shadowBlur=20;g.beginPath();g.arc(x,y,18+4*Math.sin(t*10),0,TAU);g.fill();T(g,'PICO',x,y-40,50,HY,{a:peak});}
  g.restore();}
// atleta puxando toalha presa no poste (vista de lado), cotovelo em 90°
function towelRig(g,t,pull){const sh=pull*Math.sin(t*40)*3;g.fillStyle='#9AA3AF';rr(g,900,600,46,900,12);g.fill();g.fillStyle='#6B7380';g.fillRect(880,1480,86,30);
  const S=[300,800],R=arm(g,S,.15,Math.PI/2-.15,280,260,{r:[78,62,44],bul:34+pull*14,fistR:50});
  g.save();g.strokeStyle='#E8E2D0';g.lineWidth=30;g.lineCap='round';g.beginPath();g.moveTo(R.Hc[0]+30,R.Hc[1]+sh);for(let i=1;i<=10;i++){const q=i/10;g.lineTo(lerp(R.Hc[0]+30,905,q),lerp(R.Hc[1],1000,q)+Math.sin(q*12+t*4)*(1-pull)*10+sh);}g.stroke();
  g.strokeStyle='#C9C1A8';g.lineWidth=4;for(let i=0;i<9;i++){const q=i/9+.05;const x=lerp(R.Hc[0]+30,905,q),y=lerp(R.Hc[1],1000,q);g.beginPath();g.moveTo(x-8,y-12);g.lineTo(x+8,y+12);g.stroke();}g.restore();
  g.beginPath();g.arc(S[0]-20,S[1]-150,90,0,TAU);g.fillStyle='#1A1310';g.fill();g.fillStyle=TOP;rr(g,S[0]-150,S[1]-60,200,420,60);g.fill();
  arm(g,S,.15,Math.PI/2-.15,280,260,{r:[78,62,44],bul:34+pull*14,fistR:50});return R;}
function timerRing(g,x,y,r,k,txt){g.save();g.strokeStyle='rgba(255,255,255,.12)';g.lineWidth=18;g.beginPath();g.arc(x,y,r,0,TAU);g.stroke();g.strokeStyle=HG;g.shadowColor=HG;g.shadowBlur=16;g.beginPath();g.arc(x,y,r,-Math.PI/2,-Math.PI/2+TAU*cl(k));g.stroke();g.restore();T(g,txt,x,y+30,90,WHT);}

