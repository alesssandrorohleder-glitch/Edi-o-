{"falas": [{"t0": 0.35, "t1": 2.103, "txt": "Antebraço de aço em dez minutos."}, {"t0": 2.503, "t1": 5.551, "txt": "Sem academia: só uma toalha, uma garrafa e um elástico."}, {"t0": 5.951, "t1": 7.511, "txt": "Salva esse vídeo e faz comigo."}, {"t0": 8.511, "t1": 12.373, "txt": "Um: torção de toalha. Torce como se fosse espremer, pros dois lados."}, {"t0": 13.323, "t1": 16.613, "txt": "Dois: rósca de punho com a garrafa. Apenas o punho sobe."}, {"t0": 17.563, "t1": 21.347, "txt": "Três: alavanca com a garrafa. Segura na ponta e gira o punho devagar."}, {"t0": 22.297, "t1": 25.702, "txt": "Quatro: elástico nos dedos. Abre a mão o máximo que conseguir."}, {"t0": 26.652, "t1": 30.515, "txt": "Cinco: aperto máximo. Enrola a toalha e aperta com toda a força."}, {"t0": 31.465, "t1": 34.116, "txt": "Faça três voltas, com trinta segundos de descanso."}, {"t0": 34.816, "t1": 38.245, "txt": "Três vezes por semana, e em um mês você sente a diferença na pegada."}, {"t0": 38.995, "t1": 40.151, "txt": "Salva pra não esquecer."}, {"t0": 40.501, "t1": 42.361, "txt": "E segue lá o perfil pra mais treinos."}], "words": [[0.0, 0.82, "Antebraço"], [0.82, 0.94, "de"], [0.94, 1.1, "aço"], [1.1, 1.22, "em"], [1.22, 1.36, "10"], [1.36, 1.8, "minutos."], [2.34, 2.62, "Sem"], [2.62, 3.02, "academia,"], [3.32, 3.44, "só"], [3.44, 3.58, "uma"], [3.58, 3.94, "toalha,"], [4.18, 4.26, "uma"], [4.26, 4.7, "garrafa"], [4.7, 4.88, "e"], [4.88, 4.96, "um"], [4.96, 5.36, "elástico."], [5.86, 6.18, "Salve"], [6.18, 6.34, "esse"], [6.34, 6.58, "vídeo"], [6.58, 6.84, "e"], [6.84, 6.98, "faz"], [6.98, 7.28, "comigo."], [8.22, 8.66, "1."], [8.84, 9.08, "Trouxão"], [9.08, 9.2, "de"], [9.2, 9.66, "toalha."], [10.08, 10.34, "Torça"], [10.34, 10.52, "como"], [10.52, 10.64, "se"], [10.64, 10.86, "fosse"], [10.86, 11.4, "espremer"], [11.4, 11.58, "para"], [11.58, 11.68, "os"], [11.68, 11.8, "dois"], [11.8, 12.12, "lados."], [13.04, 13.52, "2."], [13.88, 13.98, "Rosta"], [13.98, 14.16, "de"], [14.16, 14.4, "punho