/* ---------- extras ---------- */
function arrow(g,pts,k,col=WHT,w=26){if(k<=0)return;const n=Math.max(2,Math.ceil(pts.length*cl(k)));const P=pts.slice(0,n);g.save();g.strokeStyle=col;g.fillStyle=col;g.lineWidth=w;g.lineCap='round';g.lineJoin='round';g.shadowColor='rgba(0,0,0,.5)';g.shadowBlur=20;
  g.beginPath();P.forEach((q,i)=>i?g.lineTo(...q):g.moveTo(...q));g.stroke();const a=P[P.length-1],b=P[P.length-2],an=Math.atan2(a[1]-b[1],a[0]-b[0]);g.translate(...a);g.rotate(an);g.beginPath();g.moveTo(w*1.6,0);g.lineTo(-w*.6,-w*1.5);g.lineTo(-w*.6,w*1.5);g.fill();g.restore();}
const curve=(a,c,b,n=14)=>Array.from({length:n+1},(_,i)=>{const s=i/n;return[(1-s)**2*a[0]+2*(1-s)*s*c[0]+s*s*b[0],(1-s)**2*a[1]+2*(1-s)*s*c[1]+s*s*b[1]];});
const rot=(p,a)=>[p[0]*Math.cos(a)-p[1]*Math.sin(a),p[0]*Math.sin(a)+p[1]*Math.cos(a)];
// vista de cima: mesa, adversário em cima, herói embaixo. w=1 postura ERRADA (ombro longe, corpo e rosto virados), w=0 CERTA
function topView(g,cx,cy,s,w,t,o={}){g.save();g.translate(cx,cy);g.scale(s,s);
  rr(g,-320,-200,640,400,40);let gr=g.createLinearGradient(0,-200,0,200);gr.addColorStop(0,'#6B4A33');gr.addColorStop(1,'#3E2A1C');g.fillStyle=gr;g.fill();g.strokeStyle='#2A1A10';g.lineWidth=10;g.stroke();
  for(const yy of[-120,120]){g.fillStyle='rgba(20,12,8,.6)';g.beginPath();g.ellipse(40,yy,80,34,0,0,TAU);g.fill();}
  g.fillStyle='#9AA3B5';rr(g,-280,-28,28,56,10);g.fill();rr(g,252,-28,28,56,10);g.fill();
  const torso=(c,a,col)=>{g.save();g.translate(...c);g.rotate(a);const gg=g.createLinearGradient(0,-90,0,90);gg.addColorStop(0,'#3A4150');gg.addColorStop(1,col);g.beginPath();g.ellipse(0,0,230,88,0,0,TAU);g.fillStyle=gg;g.fill();g.strokeStyle='rgba(255,255,255,.18)';g.lineWidth=6;g.stroke();
    for(const sx of[-1,1]){g.beginPath();g.arc(sx*192,0,52,0,TAU);g.fillStyle=SKD;g.fill();}g.restore();};
  const head=(c,look,hair,skin)=>{g.save();g.translate(...c);g.rotate(look);g.fillStyle=skin;g.beginPath();g.ellipse(-6,-72,14,20,0,0,TAU);g.ellipse(-6,72,14,20,0,0,TAU);g.fill();
    g.fillStyle=hair;g.beginPath();g.arc(0,0,72,0,TAU);g.fill();g.fillStyle=skin;g.beginPath();g.ellipse(44,0,28,42,0,-Math.PI/2,Math.PI/2);g.fill();g.beginPath();g.moveTo(70,-13);g.lineTo(94,0);g.lineTo(70,13);g.fill();g.restore();};
  // adversário (em cima)
  const OT=[-20,-330];limb(g,[-210,OT[1]],[-250,-40],46,38,8,SK2,SK2D,SK2L,1,'fo');torso(OT,0,'#1A1D24');
  limb(g,[170,OT[1]],[-20,-120],48,40,12,SK2,SK2D,SK2L,-1,'up');limb(g,[-20,-120],[0,-14],40,32,10,SK2,SK2D,SK2L,-1,'fo');head([OT[0],OT[1]-4],Math.PI/2,'#1A1310',SK2D);
  // herói (embaixo)
  const Tc=[lerp(60,-70,w),lerp(300,450,w)],ra=lerp(-.3,.42,w),Rs=v=>{const q=rot(v,ra);return[Tc[0]+q[0],Tc[1]+q[1]];};
  const SHR=Rs([192,0]),SHL=Rs([-192,0]),EL=[lerp(70,150,w),lerp(120,150,w)],HD=[0,10];
  limb(g,SHL,[-250,40],46,38,8,SKIN,SKD,SKL,-1,'fo');torso(Tc,ra,'#151820');
  limb(g,SHR,EL,50,42,14,SKIN,SKD,SKL,1,'up');limb(g,EL,HD,42,32,10,SKIN,SKD,SKL,1,'fo');fist(g,0,-6,44,-Math.PI/2,SKIN,SKD,SKL);
  const H=Rs([0,0]),look=Math.atan2(HD[1]-H[1],HD[0]-H[0])+w*1.9;
  if(o.cone!==false){g.save();g.globalCompositeOperation='lighter';g.translate(...H);g.rotate(look);gr=g.createRadialGradient(0,0,40,0,0,520);const cc=w>.5?'255,46,63':'198,255,46';gr.addColorStop(0,`rgba(${cc},.42)`);gr.addColorStop(1,`rgba(${cc},0)`);g.fillStyle=gr;g.beginPath();g.moveTo(0,0);g.arc(0,0,520,-.3,.3);g.closePath();g.fill();g.restore();}
  head(H,look,'#1A1310',SKD);
  g.restore();return{SHR:[cx+SHR[0]*s,cy+SHR[1]*s],EL:[cx+EL[0]*s,cy+EL[1]*s],H:[cx+H[0]*s,cy+H[1]*s],Tc:[cx+Tc[0]*s,cy+Tc[1]*s],look};}
function slowmo(g,t,k=1){if(k<=0)return;g.save();g.globalAlpha=k;rr(g,70,290,250,80,40);g.fillStyle='rgba(0,0,0,.55)';g.fill();g.fillStyle=RED;g.globalAlpha=k*(.5+.5*Math.sin(t*10));g.beginPath();g.arc(110,330,14,0,TAU);g.fill();g.globalAlpha=k;T(g,'0,25×',220,348,48,WHT,{f:'Pop'});g.restore();}
function bars(g){g.fillStyle='#000';g.fillRect(0,0,W,120);g.fillRect(0,H-120,W,120);}

