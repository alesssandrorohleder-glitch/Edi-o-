/* ---------- composição + transições ---------- */
const[CA,ca]=mk(),[CB,cb]=mk(),[GR,gg]=mk(540,960);
{const d=gg.createImageData(540,960);for(let i=0;i<d.data.length;i+=4){const v=128+(Math.random()-.5)*90;d.data[i]=d.data[i+1]=d.data[i+2]=v;d.data[i+3]=255;}gg.putImageData(d,0,0);}
const TR=.24;
function renderScene(g,i,t){const s=S[i];g.reset();g.setTransform(1,0,0,1,0,0);g.globalAlpha=1;g.globalCompositeOperation='source-over';g.filter='none';s.fn(g,t-s.t0,t);}
window.DUR=32.8;
window.draw=function(t){let i=S.length-1;while(i>0&&t<S[i].t0)i--;const s=S[i],u=t-s.t0,x=X0;x.setTransform(1,0,0,1,0,0);x.globalAlpha=1;x.globalCompositeOperation='source-over';
  renderScene(ca,i,t);
  if(i>0&&u<TR&&s.tr!='cut'){renderScene(cb,i-1,t);const k=eio(u/TR);x.fillStyle='#000';x.fillRect(0,0,W,H);
    if(s.tr=='whipL'){x.save();x.globalAlpha=1;x.drawImage(CB,-k*W,0);for(let j=1;j<5;j++){x.globalAlpha=.18;x.drawImage(CB,-k*W+j*40,0);}x.restore();
      x.globalAlpha=1;x.drawImage(CA,(1-k)*W,0);for(let j=1;j<5;j++){x.globalAlpha=.18;x.drawImage(CA,(1-k)*W+j*40,0);}x.globalAlpha=1;}
    else if(s.tr=='up'){x.drawImage(CB,0,-k*H);x.drawImage(CA,0,(1-k)*H);}
    else if(s.tr=='zoom'){x.save();x.translate(W/2,H/2);const a=1+k*.6;x.scale(a,a);x.globalAlpha=1-k;x.drawImage(CB,-W/2,-H/2);x.restore();x.save();x.translate(W/2,H/2);const b=lerp(.7,1,k);x.scale(b,b);x.globalAlpha=k;x.drawImage(CA,-W/2,-H/2);x.restore();
      x.fillStyle=`rgba(255,255,255,${Math.sin(k*Math.PI)*.35})`;x.globalAlpha=1;x.fillRect(0,0,W,H);}
    else if(s.tr=='circle'){x.drawImage(CB,0,0);x.save();x.beginPath();x.arc(W/2,H/2,k*1200,0,TAU);x.clip();x.drawImage(CA,0,0);x.restore();x.strokeStyle=LIME;x.lineWidth=24;x.beginPath();x.arc(W/2,H/2,k*1200,0,TAU);x.stroke();}}
  else{const pz=s.tr=='cut'?0:Math.exp(-(u-TR)*7)*.05;x.save();x.translate(W/2,H/2);x.scale(1+pz,1+pz);x.drawImage(CA,-W/2,-H/2);x.restore();}
  // vinheta + grão
  x.globalAlpha=1;const g2=x.createRadialGradient(W/2,H/2,H*.3,W/2,H/2,H*.75);g2.addColorStop(0,'rgba(0,0,0,0)');g2.addColorStop(1,'rgba(0,0,0,.55)');x.fillStyle=g2;x.fillRect(0,0,W,H);
  x.globalAlpha=.05;x.globalCompositeOperation='overlay';x.drawImage(GR,(Math.floor(t*30)*137)%540-540,0,W*2,H);x.globalAlpha=1;x.globalCompositeOperation='source-over';};
window.ready=true;
</script>
