  g.beginPath();g.moveTo(-110,-150);g.quadraticCurveTo(0,-200,110,-150);g.quadraticCurveTo(140,-40,90,40);g.lineTo(-90,40);g.quadraticCurveTo(-140,-40,-110,-150);g.closePath();
  gr=g.createLinearGradient(-120,-150,120,40);gr.addColorStop(0,SKD);gr.addColorStop(.45,SKIN);gr.addColorStop(1,SKL);g.fillStyle=gr;g.fill();g.strokeStyle='rgba(70,28,12,.6)';g.lineWidth=6;g.stroke();
  g.lineCap='round';for(const[x0,x1,w]of[[-80,-150,62],[80,150,56]]){g.strokeStyle='rgba(70,28,12,.6)';g.lineWidth=w+8;g.beginPath();g.moveTo(x0,10);g.quadraticCurveTo(x1,60,x1*.95,150);g.stroke();g.strokeStyle=SKIN;g.lineWidth=w;g.stroke();
    g.fillStyle='rgba(255,226,214,.85)';g.beginPath();g.ellipse(x1*.95,140,w*.28,w*.2,0,0,TAU);g.fill();}
  g.restore();}
