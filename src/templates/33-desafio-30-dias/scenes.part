  T(g,String(Math.floor(secs)).padStart(2,'0')+'s',0,r*.25,r*.75,WHT);g.restore();}
function calGrid(g,t,x0,y0,cw,on,today=-1){for(let i=0;i<30;i++){const c=i%6,r=Math.floor(i/6),x=x0+c*cw,y=y0+r*cw,k=cl(on-i);g.save();g.translate(x+cw/2,y+cw/2);const s=k>0?lerp(.6,1,eob(cl(k*2))):1;g.scale(s,s);
  rr(g,-cw*.42,-cw*.42,cw*.84,cw*.84,cw*.18);g.fillStyle=i==today?WHT:k>0?LIME:'rgba(255,255,255,.08)';g.fill();T(g,String(i+1),0,cw*.15,cw*.38,i==today||k>0?INK:'rgba(255,255,255,.5)',{f:'Pop'});g.restore();}}
