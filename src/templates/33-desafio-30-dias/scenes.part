  g.fillStyle='#F2EBDD';g.fillRect(150,-220,14,440);g.fillStyle='rgba(255,255,255,.12)';g.fillRect(-150,-200,40,400);T(g,'LIVRO',10,20,70,'rgba(255,255,255,.85)',{f:'Pop'});g.restore();
  // antebraço vindo de cima + mão em pinça
